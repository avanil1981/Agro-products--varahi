# 🌾 Sri Varahi Agro Foods LLP — EmailJS Configuration Template
# Copy this file to '.env' and fill in your EmailJS credentials.
# Get these keys from your EmailJS Dashboard: https://dashboard.emailjs.com/

# 1. EmailJS Service ID (e.g., service_abc123)
REACT_APP_EMAILJS_SERVICE_ID=

# 2. EmailJS Template ID for the Contact Us Form
REACT_APP_EMAILJS_TEMPLATE_ID_CONTACT=

# 3. EmailJS Template ID for the Detailed Bulk Quotation Form
REACT_APP_EMAILJS_TEMPLATE_ID_QUOTE=

# 4. EmailJS Public Key / User ID (from Account > API Keys)
REACT_APP_EMAILJS_PUBLIC_KEY=

# 5. Nodemailer SMTP Backend Configuration
# Fill these in to route mail through your custom mail server / Gmail account
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password_here
RECEIVER_EMAIL=info@srivarahiagrofoods.in

# 6. React Frontend API URL
# Points to the local Express backend server by default
REACT_APP_API_URL=http://localhost:5001

